# Version control
.git/
.gitignore

# Python runtime artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Node / frontend build artifacts
frontend/node_modules/
frontend/dist/          # rebuilt in Docker from source

# Secrets — NEVER copy into the image. .env reaches the containers through
# compose env_file; credential files in secrets/ are mounted read-only at
# runtime (compose.yaml). The Google service-account key has domain-wide
# delegation: baked into a layer, anyone who can read the image holds it.
.env
.env.*
!.env.example
secrets/

# Legacy v2.6.0 student lists: personal data, not application code
students.jsonc*

# Persistent data directories — mounted as Docker volumes
images/
backups/
banks/
quizzes/

# Dev/test artifacts
tests/
*.log

# Docs (not needed at runtime)
docs/
*.md
!README.md

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
