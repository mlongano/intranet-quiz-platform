# ============================================================
# intranet-quiz-platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# THIS FILE IS COMMITTED AND PUBLIC. Every value here is a placeholder and must
# stay one. Never paste a working secret in, not even temporarily — the moment it
# is pushed it is disclosed, and the only fix is to rotate it. Put real values in
# .env, which is gitignored. Same rule for README.md, AGENTS.md and the runbooks:
# see "Secrets never belong in the repository" in docs/OPERATIONS.md.
#
# Docker Compose usage:
#   cp .env.example .env
#   # Edit .env, then:
#   docker compose up -d
#
# Bare-metal usage:
#   Copy .env to the project root, then run `uv run server.py`.

# ------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ------------------------------------------------------------
# Password for the quizparty database user.
# Used by Docker Compose to set up the DB container AND by
# the app to connect to it. Must match in both places.
#
# NOTE: this only takes effect when the database volume is first created.
# Changing it later does NOT change the password Postgres holds — see
# docs/OPERATIONS.md for the ALTER USER rotation procedure.
# Must be URL-safe: compose interpolates it into DATABASE_URL, so a '/' or
# '@' from a base64 generator would corrupt the connection string. Use hex:
#   openssl rand -hex 32
POSTGRES_PASSWORD=generate_a_strong_password

# Full database connection URL.
# Docker Compose overrides this automatically to point at the
# `db` container. For bare-metal, set it explicitly:
#   DATABASE_URL=postgresql://quizparty:<password>@localhost:5432/quizparty
# Leave blank if running with Docker Compose (it injects the value).
DATABASE_URL=

# ------------------------------------------------------------
# Auth — JWT (REQUIRED)
# ------------------------------------------------------------
# Secret key for signing HS256 JWTs. Generate a strong value:
#   openssl rand -hex 64
#
# Anyone holding this can forge a super_admin token, so it must never be
# committed, shared, or copied from an example. Generate your own.
JWT_SECRET=paste_the_openssl_output_here

# Teacher token lifetime in hours (default: 12)
JWT_TEACHER_TTL_HOURS=12

# Teacher login brute-force guard: lock an email after this many failed
# password attempts within the window (counters reset on success/restart).
# LOGIN_RATE_MAX_FAILURES=10
# LOGIN_RATE_WINDOW_SECONDS=900

# ------------------------------------------------------------
# App (REQUIRED for first-run bootstrap)
# ------------------------------------------------------------
# Email of the super-admin account created by db/bootstrap_admin.py
ADMIN_DEFAULT_EMAIL=webmaster@your-school.example

# DNS server for the app and worker containers. Needed when grading talks to a
# LAN-only host that public DNS cannot resolve — a school LLM gateway known
# only to the school's own DNS, for example. Unset = 8.8.8.8, which resolves
# public providers only.
# CONTAINER_DNS=192.0.2.53

# Port the app listens on inside Docker (default: 5001).
# Maps to the host port: "${APP_PORT:-5001}:5001" in compose.yaml.
# APP_PORT=5001

# Base directory for uploaded quiz images (set automatically in Docker).
# For bare-metal, override if you want images outside the project root:
# IMAGES_BASE=/opt/quizparty/images

# ------------------------------------------------------------
# Automatic backups (Docker Compose backup service)
# ------------------------------------------------------------
# Default: create a backup on startup, then every 6 hours, retaining 30 days.
BACKUP_ON_START=1
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_DAYS=30

# Data retention (GDPR): a session's student data is kept through 31 December
# after its school year ends, then deleted by the worker. report = only
# compute what is due (super-admin › Conservazione dati); apply = delete;
# off = neither. See docs/OPERATIONS.md › Data retention.
DATA_RETENTION=report

# ------------------------------------------------------------
# Google Workspace Sync (optional — enables /api/super-admin/sync)
# ------------------------------------------------------------
# Absolute path to the service-account JSON key file.
# Must be readable by the app process / container.
# Example: /opt/quizparty/.secrets/sa.json
GOOGLE_SA_KEY_PATH=

# The Google Workspace admin email the service account impersonates
# (requires domain-wide delegation).
GOOGLE_DELEGATED_SUBJECT=admin@your-school.example

# Your Google Workspace domain
GOOGLE_DOMAIN=your-school.example

# Google Group whose members are provisioned as teachers.
GOOGLE_TEACHER_GROUP=docenti@your-school.example

# Comma-separated Google Workspace OU paths whose users are provisioned as students.
# Example: /Studenti,/Studenti/Triennio
GOOGLE_STUDENT_OU_PATHS=

# Optional legacy path: prefix for Google Groups that represent classes.
# Leave blank if Teachers sync rosters from Google Classroom.
# Example: a group "class-5CI" -> class name "5CI".
GOOGLE_CLASS_GROUP_PREFIX=

# Google OAuth login for Teachers (optional).
# Use a Web application OAuth client ID from Google Cloud Console.
# Backend token audience check. Must match VITE_GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional hosted-domain check. Leave blank to allow any provisioned teacher email.
GOOGLE_OAUTH_HOSTED_DOMAIN=your-school.example
# Frontend Google button client ID. Must match GOOGLE_OAUTH_CLIENT_ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ------------------------------------------------------------
# Email — send quiz results to students (optional)
# ------------------------------------------------------------
# Leave EMAIL_SENDER blank to disable all email functionality.

EMAIL_SENDER=your.email@example.com

# For Gmail: generate an App Password at
# https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------
# LLM-based open question evaluation (optional)
# ------------------------------------------------------------
# Set USE_LLM_EVAL=1 to enable automatic grading of open questions via a
# language model. With it at 0, open answers stay pending at 0 points until a
# teacher grades them by hand — they are never auto-scored some other way.
USE_LLM_EVAL=1

# Nothing else about *where* or *with which key* grading runs lives here:
#
#   - destinations and their models are the endpoint allowlist, managed by a
#     super-admin in Super Admin → Endpoint LLM;
#   - each teacher grades with their OWN key for an endpoint, stored encrypted
#     from Impostazioni → Valutazione (needs CREDENTIAL_ENCRYPTION_KEY below).
#
# There is deliberately no shared key and no fallback destination. A key in
# this file would be sent on every teacher's behalf, unattributable, and the
# allowlist would stop being the authority on what grading may contact. The
# old LLM_PROVIDER / LLM_MODEL / LLM_BASE_URL / *_API_KEY variables are ignored.
#
# A teacher without a key simply has open answers left pending. With no enabled
# default endpoint the app still starts and logs a warning: grading being
# unavailable never takes quizzes offline.

# Grading worker throughput. Each open answer is one provider call, so a class
# of 30 with six open questions is ~180 calls: serially that is a quarter of an
# hour at best. These bound how many run at once.
#
# The pool the worker opens is sized from these values, so raising the
# concurrency cannot silently starve it of connections.
LLM_WORKER_CONCURRENCY=6            # simultaneous grading calls
LLM_WORKER_MAX_JOBS=3               # jobs processed at once (a class handing in
                                    # produces one job per student)
LLM_WORKER_MAX_JOBS_PER_TEACHER=2   # 0 disables; protects one teacher's own quota

# Retry tuning. Timeouts and rate limits are retried; bad credentials and
# unknown models are not — retrying those only burns quota.
# Grading runs in the background worker, so a long timeout costs students
# nothing; it must cover generating LLM_MAX_TOKENS, reasoning included.
LLM_TIMEOUT_SECONDS=120
LLM_RETRIES=0
# Output budget per answer. Reasoning models (Qwen3) think before the
# verdict: too low and the reply arrives empty ("risposta troncata").
LLM_MAX_TOKENS=4096
LLM_BACKOFF_FACTOR=0.5

# Optional: override the versioned Markdown prompts for open-question grading.
# Normally the newest file in prompts/open-question-{system,user}/ is used and
# recorded with each grade; an override is recorded as custom-<hash> instead.
# Relative paths are resolved from the project root inside the app container.
# LLM_OPEN_QUESTION_SYSTEM_PROMPT_PATH=prompts/open-question-system/v1-52b7d507.md
# LLM_OPEN_QUESTION_USER_PROMPT_PATH=prompts/open-question-user/v1-369c1751.md

# ------------------------------------------------------------
# Teacher API keys — encryption master key
# ------------------------------------------------------------
# Teachers' keys are encrypted with this master key before being written to the
# database, so a database dump does not leak them. Required for automatic
# grading: without it no teacher can store a key, and since grading uses only
# teachers' own keys, open answers then stay pending for everyone.
#
# Generate one with:
#   docker compose exec app python scripts/rotate_credential_key.py --generate
#
# ROTATION: run scripts/rotate_credential_key.py --new-key '<new>' BEFORE
# replacing the value here. Changing it without re-encrypting makes every
# stored key unreadable and each teacher has to enter theirs again.
# CREDENTIAL_ENCRYPTION_KEY=
